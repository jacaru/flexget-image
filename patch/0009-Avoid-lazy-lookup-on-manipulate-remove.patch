From: jacaru <1446775+jacaru@users.noreply.github.com>
Date: Sat, 24 Apr 2021 01:51:09 +0200
Subject: [PATCH 09/13] Avoid lazy lookup on manipulate remove

---
 flexget/plugins/modify/manipulate.py | 13 +++++++------
 1 file changed, 7 insertions(+), 6 deletions(-)

diff --git a/flexget/plugins/modify/manipulate.py b/flexget/plugins/modify/manipulate.py
index 34bf82ed4..c1007304d 100644
--- a/flexget/plugins/modify/manipulate.py
+++ b/flexget/plugins/modify/manipulate.py
@@ -121,6 +121,13 @@ class Manipulate:
                 from_field = field
                 if 'from' in config:
                     from_field = config['from']
+                if config.get('remove'):
+                    try:
+                        del entry[field]
+                        modified = True
+                    except KeyError:
+                        pass
+                    continue
                 field_value = entry.get(from_field)
                 logger.debug(
                     'field: `{}` from_field: `{}` field_value: `{}`',
@@ -128,12 +135,6 @@ class Manipulate:
                     from_field,
                     field_value,
                 )
-                if config.get('remove'):
-                    # Remove entire field
-                    if field in entry:
-                        del entry[field]
-                        modified = True
-                    continue
                 if config.get('erase'):
                     # Erase text matching regex patterns
                     if not field_value:
